---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import IndexRow from '../../components/IndexRow.astro';
import { getTagIndex } from '../../data/tagIndex';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

type Props = {
  post: CollectionEntry<'blog'>;
};

const { post } = Astro.props;
const { Content } = await post.render();

const formatDate = (date: Date) =>
  date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

const fmtShort = (d: Date) =>
  d.toLocaleDateString('en-GB', { month: 'short', year: 'numeric' }).toLowerCase();

// Get related posts (same tags, sorted by newest first)
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const relatedPosts = allPosts
  .filter(p => p.slug !== post.slug)
  .filter(p => p.data.tags.some(tag => post.data.tags.includes(tag)))
  .sort((a, b) => {
    const dateA = new Date(a.data.publishDate).getTime();
    const dateB = new Date(b.data.publishDate).getTime();
    return dateB - dateA; // Newest first
  })
  .slice(0, 3);

const readingTime = Math.ceil(post.body.split(/\s+/).length / 200);

const tagIndex = await getTagIndex();
const linkableTags = new Set(
  [...tagIndex.values()].filter((t) => t.posts.length >= 2).map((t) => t.slug),
);
---

<Layout
  title={post.data.title.length > 45 ? post.data.title : `${post.data.title} | Aaron Dsilva`}
  description={post.data.description}
  type="article"
  image={post.data.image || "/og-image.png"}
  publishDate={post.data.publishDate}
  updatedDate={post.data.updatedDate}
>
  <article>
    <header class="px-6 sm:px-10 pt-20 sm:pt-32 pb-12 max-w-4xl">
      <a href="/blog/" class="meta inline-flex items-center gap-2 mb-10 hover:text-fg transition-colors">
        <span aria-hidden="true">←</span> Writing
      </a>

      <p class="meta mb-6">
        <time datetime={post.data.publishDate.toISOString()}>{formatDate(post.data.publishDate)}</time>
        {post.data.updatedDate && (
          <>
            <span class="mx-2">·</span>Updated <time datetime={post.data.updatedDate.toISOString()}>{formatDate(post.data.updatedDate)}</time>
          </>
        )}
        <span class="mx-2">·</span>{readingTime} min read
      </p>

      <h1 class="text-3xl sm:text-5xl font-medium tracking-tight leading-[1.08]">
        {post.data.title}
      </h1>

      <p class="mt-8 text-lg sm:text-xl leading-relaxed text-muted max-w-2xl">
        {post.data.description}
      </p>

      {post.data.tags.length > 0 && (
        <p class="mt-8 font-mono text-xs text-soft">
          {post.data.tags.map((tag, i) => [
            i > 0 && ' · ',
            linkableTags.has(tag.toLowerCase())
              ? <a href={`/blog/tags/${tag.toLowerCase()}/`} class="hover:text-fg transition-colors">{tag}</a>
              : <span>{tag}</span>,
          ])}
        </p>
      )}
    </header>

    <div class="hairline"></div>

    <div class="prose px-6 sm:px-10 py-12 sm:py-16 max-w-[68ch] mx-auto">
      <Content />
    </div>

    <footer class="hairline px-6 sm:px-10 py-12 max-w-[68ch] mx-auto">
      <p class="meta mb-4">Author</p>
      <div class="flex items-start gap-4">
        <img src="/profile.png" alt="Aaron Dsilva" width="192" height="192" loading="lazy" decoding="async" class="w-12 h-12 rounded-full object-cover shrink-0" />
        <div>
          <a href="/about/" class="text-base font-medium tracking-tight hover:text-accent transition-colors">Aaron Dsilva</a>
          <p class="mt-2 text-sm leading-relaxed text-muted">
            Aaron Dsilva is a CTO and technical lead who has spent eight years building secure, AI-powered production systems across healthcare, e-commerce, and security. He is co-founder of The Lean Product Studio and CTO at Aplify.
          </p>
        </div>
      </div>
    </footer>

    {relatedPosts.length > 0 && (
      <section class="mt-16">
        <div class="hairline px-6 sm:px-10 py-3">
          <span class="meta">Related</span>
        </div>
        {relatedPosts.map((relatedPost) => (
          <IndexRow
            href={`/blog/${relatedPost.slug}/`}
            title={relatedPost.data.title}
            meta={fmtShort(relatedPost.data.publishDate)}
          />
        ))}
      </section>
    )}
  </article>

  <!-- Article Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": post.data.title,
    "description": post.data.description,
    "image": post.data.image ? new URL(post.data.image, Astro.site).href : new URL("/og-image.png", Astro.site).href,
    "datePublished": post.data.publishDate.toISOString(),
    "dateModified": (post.data.updatedDate ?? post.data.publishDate).toISOString(),
    "author": { "@id": "https://aarondsilva.me/#person" },
    "publisher": { "@id": "https://aarondsilva.me/#person" },
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": new URL(`/blog/${post.slug}/`, Astro.site).href
    },
    "keywords": post.data.tags.join(", "),
    "articleSection": "Technology",
    "wordCount": post.body.split(/\s+/).length
  })} />

  <!-- Breadcrumb Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": new URL("/", Astro.site).href
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Blog",
        "item": new URL("/blog", Astro.site).href
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": post.data.title,
        "item": new URL(`/blog/${post.slug}`, Astro.site).href
      }
    ]
  })} />
</Layout>

<style>
  .prose {
    color: var(--fg);
    font-size: 1.0625rem;
    line-height: 1.75;
  }

  .prose > :global(:first-child) { margin-top: 0; }

  .prose :global(p) { margin: 0 0 1.5rem; }

  .prose :global(h2),
  .prose :global(h3),
  .prose :global(h4) {
    color: var(--fg);
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.25;
  }

  .prose :global(h2) {
    font-size: 1.625rem;
    margin: 3rem 0 1rem;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }

  .prose :global(h3) { font-size: 1.3rem; margin: 2.25rem 0 0.75rem; }
  .prose :global(h4) { font-size: 1.0625rem; margin: 2rem 0 0.5rem; }

  .prose :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
    transition: opacity 0.2s ease;
  }
  .prose :global(a:hover) { opacity: 0.7; }

  .prose :global(strong) { color: var(--fg); font-weight: 600; }

  .prose :global(ul),
  .prose :global(ol) { margin: 0 0 1.5rem; padding-left: 1.5rem; }
  .prose :global(ul) { list-style-type: disc; }
  .prose :global(ol) { list-style-type: decimal; }
  .prose :global(li) { margin-bottom: 0.5rem; padding-left: 0.25rem; }
  .prose :global(li::marker) { color: var(--soft); }

  .prose :global(blockquote) {
    border-left: 1px solid var(--line-strong);
    padding-left: 1.5rem;
    margin: 2rem 0;
    color: var(--muted);
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.25rem;
    line-height: 1.5;
  }
  .prose :global(blockquote p) { margin: 0; }

  .prose :global(hr) {
    border: none;
    border-top: 1px solid var(--line);
    margin: 3rem 0;
  }

  /* Inline code */
  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background: var(--raised);
    padding: 0.15em 0.4em;
    border-radius: 3px;
    border: 1px solid var(--line);
    color: var(--fg);
  }

  /* Shiki code blocks — dual theme (github-light / github-dark) */
  .prose :global(pre.astro-code) {
    background: var(--code-bg) !important;
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 1.25rem;
    margin: 2rem 0;
    overflow-x: auto;
    font-size: 0.85rem;
    line-height: 1.6;
  }
  .prose :global(pre.astro-code code) {
    background: transparent;
    border: none;
    padding: 0;
    font-size: inherit;
    color: inherit;
  }
  /* Switch shiki tokens to the dark theme when .dark is active */
  :global(.dark) .prose :global(pre.astro-code),
  :global(.dark) .prose :global(pre.astro-code span) {
    color: var(--shiki-dark) !important;
  }

  /* Images / SVGs constrained to content width */
  .prose :global(img),
  .prose :global(svg) { max-width: 100%; height: auto; }
  .prose :global(img) {
    border-radius: 6px;
    border: 1px solid var(--line);
    margin: 2rem 0;
  }

  /* Tables — scroll wrapper for wide tables */
  .prose :global(table) {
    display: block;
    width: 100%;
    max-width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    margin: 2rem 0;
    font-size: 0.9375rem;
  }
  .prose :global(th),
  .prose :global(td) {
    padding: 0.625rem 1rem;
    text-align: left;
    white-space: nowrap;
    border-bottom: 1px solid var(--line);
  }
  .prose :global(th) {
    color: var(--fg);
    font-weight: 600;
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* Mermaid diagrams — never clipped, scroll if wide */
  .prose :global(pre.mermaid),
  .prose :global(.mermaid) {
    background: transparent;
    border: none;
    padding: 0;
    margin: 2rem 0;
    overflow-x: auto;
    text-align: center;
  }
  .prose :global(pre.mermaid svg),
  .prose :global(.mermaid svg) {
    max-width: 100%;
    height: auto;
  }
</style>
