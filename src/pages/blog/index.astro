---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import IndexRow from '../../components/IndexRow.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => {
    const dateA = new Date(a.data.publishDate).getTime();
    const dateB = new Date(b.data.publishDate).getTime();
    return dateB - dateA; // Newest first
  });

const fmt = (d: Date) => d.toLocaleDateString('en-GB', { month: 'short', year: 'numeric' }).toLowerCase();

const years = [...new Set(posts.map((post) => post.data.publishDate.getFullYear()))];
---

<Layout
  title="Writing | Aaron Dsilva"
  description="Practical notes on healthcare tech, AWS, AI, and security compliance, from production experience."
>
  <section class="px-6 sm:px-10 pt-20 sm:pt-32 pb-16 sm:pb-24 max-w-4xl">
    <p class="meta mb-8">Writing</p>
    <h1 class="text-4xl sm:text-6xl font-medium tracking-tight leading-[1.06]">Writing</h1>
    <p class="mt-8 text-base leading-relaxed text-muted max-w-xl">
      Practical notes on healthcare tech, AWS, AI, and security compliance, from production experience.
    </p>
    <a href="/blog/tags/" class="meta mt-8 inline-flex items-center gap-2 hover:text-fg transition-colors">
      Browse by topic <span aria-hidden="true">→</span>
    </a>
  </section>

  {years.map((year) => (
    <section>
      <div class="hairline px-6 sm:px-10 py-3">
        <span class="meta">{year}</span>
      </div>
      {posts.filter((post) => post.data.publishDate.getFullYear() === year).map((post) => (
        <IndexRow href={`/blog/${post.slug}/`} title={post.data.title} meta={fmt(post.data.publishDate)} />
      ))}
    </section>
  ))}
</Layout>
