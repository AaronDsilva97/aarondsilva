---
import Layout from '../layouts/Layout.astro';

const links = [
  { label: 'Book a call', href: 'https://calendly.com/aaronxdsilva/30min', meta: 'calendly', external: true },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/aaronxdsilva/', meta: '@aaronxdsilva', external: true },
  { label: 'GitHub', href: 'https://github.com/AaronDsilva97', meta: '@AaronDsilva97', external: true },
];
---
<Layout title="Contact — Aaron Dsilva" description="Get in touch with Aaron Dsilva, co-founder of The Lean Product Studio and CTO at Aplify.">
  <section class="px-6 sm:px-10 pt-20 sm:pt-32 pb-16 sm:pb-24 max-w-3xl">
    <p class="meta mb-8">Contact</p>
    <h1 class="text-4xl sm:text-6xl font-medium tracking-tight leading-[1.06]">Get in touch</h1>
    <p class="mt-10 text-base sm:text-lg leading-relaxed text-muted max-w-xl">
      The fastest way to reach me is email. I usually reply within a day.
    </p>
    <a href="mailto:contact@aarondsilva.me"
       class="display mt-8 inline-block text-3xl sm:text-5xl font-medium tracking-tight hover:text-accent transition-colors">
      contact@aarondsilva.me
    </a>
    <p class="meta flex items-center gap-2 text-sage mt-10">
      <span class="w-1.5 h-1.5 rounded-full bg-sage"></span>Open to advisory and co-founding conversations
    </p>
  </section>

  <section>
    <div class="hairline px-6 sm:px-10 py-3">
      <span class="meta">Elsewhere</span>
    </div>
    {links.map(l => (
      <a href={l.href} {...l.external ? { target: '_blank', rel: 'noopener' } : {}}
         class="group hairline flex items-baseline justify-between gap-4 px-6 sm:px-10 py-5 hover:bg-raised transition-colors">
        <span class="text-lg sm:text-xl font-medium tracking-tight">
          {l.label}<span class="text-accent text-sm ml-1">↗</span>
        </span>
        <span class="meta shrink-0 group-hover:text-muted transition-colors">{l.meta}</span>
      </a>
    ))}
  </section>
</Layout>
