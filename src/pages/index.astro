---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Intro from '../components/Intro.astro';
import IndexRow from '../components/IndexRow.astro';
import { flagship } from '../data/projects';
const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 5);
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { month: 'short', year: 'numeric' }).toLowerCase();
---
<Layout>
  <Intro />
  <section class="px-6 sm:px-10 pt-20 sm:pt-32 pb-24 max-w-4xl">
    <p class="meta mb-8">CTO · Healthcare — Commerce — Security</p>
    <h1 class="text-4xl sm:text-6xl font-medium tracking-tight leading-[1.06]">
      Hi, I'm Aaron.<br />I help turn ambitious ideas<br />into products people <em class="font-serif italic font-normal">trust</em>.
    </h1>
    <p class="mt-8 text-lg sm:text-xl leading-relaxed text-fg max-w-2xl">
      Through thoughtful engineering, product thinking, and a lot of shipping.
    </p>
    <p class="mt-6 text-lg leading-relaxed text-muted max-w-xl">
      Co-founder of The Lean Product Studio and CTO at Aplify. I lead a team of ten
      engineers, still write code every day, and spend most of my energy on Clinvo,
      an AI-native EHR for modern clinics.
    </p>
    <a href="/contact" class="mt-8 inline-flex items-center gap-2 meta text-sage hover:text-fg transition-colors">
      <span class="w-1.5 h-1.5 rounded-full bg-sage"></span>Open to advisory work · Get in touch →
    </a>
  </section>

  <section>
    <div class="hairline flex justify-between px-6 sm:px-10 py-3">
      <span class="meta">Selected work</span>
      <a href="/work" class="meta hover:text-fg transition-colors">All work →</a>
    </div>
    {flagship.map(p => (
      <IndexRow href={p.url} external title={p.name} meta={`${p.role.toLowerCase()} · ${p.domain.toLowerCase()} · ${p.year}`} />
    ))}
  </section>

  <section class="mt-24">
    <div class="hairline flex justify-between px-6 sm:px-10 py-3">
      <span class="meta">Writing</span>
      <a href="/blog" class="meta hover:text-fg transition-colors">All writing →</a>
    </div>
    {posts.map(p => (
      <IndexRow href={`/blog/${p.slug}/`} title={p.data.title} meta={fmt(p.data.publishDate)} />
    ))}
  </section>
</Layout>
