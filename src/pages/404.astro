---
import Layout from '../layouts/Layout.astro';
---
<Layout title="404 — Aaron Dsilva" description="This page doesn't exist.">
  <section class="px-6 sm:px-10 pt-20 sm:pt-32 pb-16 sm:pb-24 max-w-3xl">
    <p class="meta mb-8">404</p>
    <h1 class="text-4xl sm:text-6xl font-medium tracking-tight leading-[1.06]">This page doesn't exist.</h1>
    <div class="mt-10 flex flex-wrap gap-x-8 gap-y-3 text-sm text-muted">
      <a class="hover:text-fg transition-colors" href="/">Home<span class="text-accent text-sm ml-1">→</span></a>
      <a class="hover:text-fg transition-colors" href="/blog">Blog<span class="text-accent text-sm ml-1">→</span></a>
    </div>
  </section>
</Layout>
