---
import Layout from '../layouts/Layout.astro';
import { experience } from '../data/experience';
import { certifications } from '../data/certifications';

const featured = certifications.filter(c => c.featured);

const contacts = [
  { label: '+91 9730659141', href: 'tel:+919730659141' },
  { label: 'contact@aarondsilva.me', href: 'mailto:contact@aarondsilva.me' },
  { label: 'linkedin.com/in/aaronxdsilva', href: 'https://linkedin.com/in/aaronxdsilva' },
  { label: 'github.com/AaronDsilva97', href: 'https://github.com/AaronDsilva97' },
  { label: 'aarondsilva.me', href: 'https://aarondsilva.me' },
  { label: 'theleanproduct.studio', href: 'https://theleanproduct.studio' },
  { label: 'itihaas.ai', href: 'https://itihaas.ai' },
];

const achievements = [
  { k: 'AWS Cost Optimization', v: "cut a client's AWS bill by 33% through architecture optimization and right-sizing" },
  { k: 'Healthcare Scale', v: 'hospital organizations across the US and India with 99.9% uptime, zero security incidents, and FDA/HIPAA/SOC 2/ISO 27001 compliance' },
  { k: 'E-commerce Recovery', v: 'rebuilt a failing multi-vendor marketplace (constant crashes, broken UI) from scratch to 100% uptime and a modern Flutter/Node architecture' },
  { k: 'AI/RAG Production Systems', v: 'shipped 4+ healthcare AI systems including ambient clinical listening (AWS Comprehend Medical + Claude + Neo4j), MCP research servers, and HIPAA-compliant RAG pipelines used by teams at King’s College London and European hospitals' },
  { k: 'Security Leadership', v: 'led pen testing remediation implementing all security fixes in production code (React Native/Flask), built an ISO 27001 pen testing platform, and passed every audit (FDA/HIPAA/SOC 2/GDPR)' },
  { k: 'Team Leadership', v: 'built and led a distributed team of 10 engineers across time zones, shipping 6 products to production spanning healthcare, e-commerce, security, and research tools' },
];

const projects = [
  {
    name: 'AI Clinical Documentation System',
    context: 'Healthcare AI · HIPAA · 2024',
    summary: 'In development (pre-deployment): an AI clinical documentation system for hospital teams in the US and Europe. Processes physician–patient conversations to generate clinical notes while preserving patient privacy.',
    lines: [
      'Stack: AWS Comprehend Medical (PHI extraction/anonymization), Claude API (summarization), Neo4j (knowledge graphs), Python, HIPAA-compliant AWS architecture',
      'Compliance: built-in PHI anonymization, encrypted data pipeline, and audit logging',
    ],
    tags: ['AWS Comprehend Medical', 'Claude API', 'Neo4j', 'HIPAA'],
  },
  {
    name: 'Multi-Vendor E-commerce Marketplace Rebuild',
    context: 'The Lean Product Studio Client · 2024',
    summary: 'Rescued a failing multi-vendor marketplace plagued by constant crashes and poor UX. Complete rebuild from the ground up with modern architecture, reaching 100% uptime and significantly improved vendor and customer satisfaction.',
    lines: [
      'Stack: Flutter (mobile apps), Node.js (backend), MongoDB, AWS, real-time inventory sync, payment gateway integration',
      'Impact: crash rate reduced from daily to zero, app performance improved 300%, rebuilt UI/UX increasing conversion by 40%, vendor admin dashboards reducing support tickets by 60%',
      'Features: multi-vendor onboarding, product catalog management, real-time inventory, payment processing, order tracking, and admin analytics',
    ],
    tags: ['Flutter', 'Node.js', 'MongoDB', 'AWS'],
  },
  {
    name: 'ISO 27001 Penetration Testing Platform',
    context: 'Enterprise Security Clients · 2024',
    summary: 'A SaaS platform connecting penetration testers to development teams for enterprise security workflows — centralized vulnerability tracking, remediation verification, and regression testing for ISO 27001 compliance.',
    lines: [
      'Stack: NestJS (TypeScript backend), PostgreSQL (secure data storage), AWS, role-based access control, encrypted storage',
      'Capabilities: automated regression testing that prevents re-occurrence of fixed vulnerabilities, and a centralized dashboard for real-time security-posture visibility',
      'Compliance: ISO 27001-compliant architecture, audit trails, secure credential management, and encrypted communications',
    ],
    tags: ['NestJS', 'PostgreSQL', 'ISO 27001', 'Security'],
  },
];

const skills = [
  { label: 'Leadership & Architecture', items: 'CTO / Head of Engineering, Technical Leadership, Team Building (10+ engineers), AWS Solutions Architecture, System Design, Multi-Tenant SaaS, Microservices' },
  { label: 'Compliance & Security', items: 'HIPAA, FDA 510(k), SOC 2 Type II, ISO 27001, GDPR, Penetration Testing Remediation, Security Architecture, Encryption (AES-256), RBAC, Audit Logging' },
  { label: 'AI & Machine Learning', items: 'RAG Pipelines, Neo4j (Knowledge Graphs), Pinecone (Vector DB), LangChain, Claude API, Gemini, OpenAI, AWS Comprehend Medical, Embeddings, MCP (Model Context Protocol)' },
  { label: 'Mobile Development', items: 'React Native, Flutter (Dart), Offline-First Architecture, Real-Time Sync, iOS/Android Deployment, App Store Optimization' },
  { label: 'Backend & APIs', items: 'Node.js (Express, NestJS), Ruby on Rails, Laravel (PHP), Flask (Python), RESTful APIs, GraphQL, WebSockets, Microservices, Serverless (AWS Lambda)' },
  { label: 'Cloud & Infrastructure', items: 'AWS (EC2, Lambda, RDS, S3, CloudFront, API Gateway, CloudWatch, Comprehend Medical), Infrastructure as Code, CI/CD Pipelines, Docker, Kubernetes' },
  { label: 'Databases', items: 'PostgreSQL (Row-Level Security), MongoDB, Neo4j (Graph DB), Pinecone (Vector DB), Redis (Caching), MySQL, SQLite (Offline Mobile)' },
  { label: 'Programming Languages', items: 'JavaScript / TypeScript, Python, Dart / Flutter, Ruby, PHP, SQL' },
  { label: 'Domain Expertise', items: 'Healthcare IT, E-commerce Platforms, Multi-Vendor Marketplaces, Security / SaaS, Telemedicine, Clinical Documentation, Disaster Recovery, Multi-Language / i18n' },
  { label: 'Methodologies & Certifications', items: 'Agile / Scrum (PSM I), AWS Solutions Architect, DevOps, Test-Driven Development, Code Review, Technical Documentation' },
];

const education = [
  { degree: 'Bachelor of Engineering — Mechanical Engineering', school: "Modern Education Society's College of Engineering, Pune", period: '2014 — 2018' },
  { degree: 'HSC, Science', school: "Modern Education Society's Nowrosjee Wadia College, Pune", period: '2012 — 2014' },
];
---
<Layout title="CV — Aaron Dsilva" description="CTO with 8 years building HIPAA-compliant healthcare systems and e-commerce platforms. 33% AWS cost reduction, zero security incidents across audits. AWS Certified.">
  <section class="cv-head px-6 sm:px-10 pt-20 sm:pt-28 pb-8 max-w-3xl">
    <p class="meta mb-8">CTO · Healthcare — Commerce — Security</p>
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div>
        <h1 class="text-4xl sm:text-6xl font-medium tracking-tight leading-[1.06]">Aaron Dsilva</h1>
        <p class="mt-3 text-base sm:text-lg text-muted">Hands-on CTO — shipping secure, AI-powered systems across healthcare, e-commerce, and security.</p>
      </div>
      <button onclick="print()" class="no-print shrink-0 inline-flex items-center gap-2 meta text-fg hover:text-accent transition-colors border border-line rounded px-4 py-2 cursor-pointer">
        Print / Save as PDF
        <span class="text-accent">↗</span>
      </button>
    </div>
  </section>

  <div class="px-6 sm:px-10 pb-8 max-w-3xl">
    <div class="flex flex-wrap gap-x-6 gap-y-2 text-sm text-muted">
      {contacts.map(c => (
        <a href={c.href} class="hover:text-fg transition-colors">{c.label}</a>
      ))}
      <span>Pune, Maharashtra, India</span>
    </div>
  </div>

  <section class="px-6 sm:px-10 pb-4 max-w-3xl">
    <div class="space-y-5 text-base sm:text-lg leading-relaxed text-muted">
      <p>CTO and technical lead with 8 years building secure, AI-powered production systems across healthcare (HIPAA / FDA / SOC 2), e-commerce platforms, and security architecture. Currently co-founder of The Lean Product Studio and CTO at Aplify (e-commerce). Hands-on full-stack engineering combined with strategic leadership: shipping code, architecting cloud infrastructure, and leading distributed teams.</p>
      <p>Proven track record: 33% AWS cost reduction for a healthcare client, 99.9% uptime, zero security incidents across FDA/HIPAA/SOC2/ISO 27001 audits. Specialized in AI/RAG systems (Neo4j, Pinecone, Claude API), security remediation (implementing pen test fixes in production code), and compliance-first architecture for regulated industries.</p>
      <p>Delivered systems used by teams at King’s College London, Johnson & Johnson, and European hospital networks as a technical partner. AWS Certified Solutions Architect and Professional Scrum Master I. Based in Pune, India, serving global clients across US, Europe, UK, and Africa markets.</p>
    </div>
  </section>

  <section class="mt-16">
    <div class="hairline px-6 sm:px-10 py-3"><span class="meta">Key Achievements</span></div>
    <div class="px-6 sm:px-10 py-6 max-w-3xl">
      <ul class="space-y-3 text-sm sm:text-base leading-relaxed text-muted">
        {achievements.map(a => (
          <li class="cv-block flex gap-3">
            <span class="text-soft select-none">—</span>
            <span><span class="text-fg font-medium">{a.k}:</span> {a.v}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="mt-16">
    <div class="hairline px-6 sm:px-10 py-3"><span class="meta">Experience</span></div>
    {experience.map(role => (
      <div class="cv-role hairline px-6 sm:px-10 py-6">
        <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
          <h2 class="text-lg sm:text-xl font-medium tracking-tight">
            {role.org}<span class="text-muted font-normal"> · {role.title}</span>
          </h2>
          <span class="meta shrink-0">{role.period}</span>
        </div>
        <p class="meta mt-1">{role.location}</p>
        <ul class="mt-4 space-y-2 text-sm leading-relaxed text-muted max-w-2xl">
          {role.bullets.map(b => (
            <li class="flex gap-3">
              <span class="text-soft select-none">—</span>
              <span>{b}</span>
            </li>
          ))}
        </ul>
        <p class="meta mt-4">{role.stack.join(' · ')}</p>
      </div>
    ))}
  </section>

  <section class="mt-16">
    <div class="hairline px-6 sm:px-10 py-3"><span class="meta">Selected Projects</span></div>
    {projects.map(p => (
      <div class="cv-block hairline px-6 sm:px-10 py-6 max-w-3xl">
        <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
          <h2 class="text-lg sm:text-xl font-medium tracking-tight">{p.name}</h2>
        </div>
        <p class="meta mt-1">{p.context}</p>
        <p class="mt-4 text-sm sm:text-base leading-relaxed text-muted">{p.summary}</p>
        <ul class="mt-3 space-y-2 text-sm leading-relaxed text-muted">
          {p.lines.map(l => (
            <li class="flex gap-3">
              <span class="text-soft select-none">—</span>
              <span>{l}</span>
            </li>
          ))}
        </ul>
        <p class="meta mt-4">{p.tags.join(' · ')}</p>
      </div>
    ))}
  </section>

  <section class="mt-16">
    <div class="hairline px-6 sm:px-10 py-3"><span class="meta">Technical Skills</span></div>
    <div class="px-6 sm:px-10 py-6 grid sm:grid-cols-2 gap-x-10 gap-y-6 max-w-3xl">
      {skills.map(g => (
        <div class="cv-block">
          <p class="meta">{g.label}</p>
          <p class="mt-2 text-sm sm:text-base leading-relaxed text-muted">{g.items}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="mt-16">
    <div class="hairline px-6 sm:px-10 py-3"><span class="meta">Certifications</span></div>
    {featured.map(c => (
      <div class="cv-block hairline flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 px-6 sm:px-10 py-4">
        <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
          <span class="text-base sm:text-lg font-medium tracking-tight">
            {c.url ? (
              <a href={c.url} target="_blank" rel="noopener" class="hover:text-accent transition-colors">{c.name}<span class="text-accent text-sm ml-1">↗</span></a>
            ) : c.name}
          </span>
          <span class="meta">{c.issuer}</span>
        </div>
        <span class="meta shrink-0">{c.date}</span>
      </div>
    ))}
  </section>

  <section class="mt-16 pb-8">
    <div class="hairline px-6 sm:px-10 py-3"><span class="meta">Education</span></div>
    {education.map(e => (
      <div class="cv-block hairline flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 px-6 sm:px-10 py-4">
        <div>
          <span class="text-base sm:text-lg font-medium tracking-tight">{e.degree}</span>
          <span class="meta block sm:inline sm:ml-3 mt-1 sm:mt-0">{e.school}</span>
        </div>
        <span class="meta shrink-0">{e.period}</span>
      </div>
    ))}
  </section>
</Layout>

<style is:global>
  @media print {
    @page {
      size: A4;
      margin: 14mm 14mm;
    }
    :root,
    :root.dark {
      --bg: #ffffff;
      --fg: #000000;
      --muted: #333333;
      --soft: #555555;
      --line: #c9c9c9;
      --line-strong: #000000;
      --accent: #000000;
    }
    html,
    body {
      background: #ffffff !important;
      color: #000000 !important;
    }
    header,
    footer,
    .no-print {
      display: none !important;
    }
    .grain::after {
      display: none !important;
    }
    a {
      color: inherit !important;
      text-decoration: none !important;
    }
    .cv-head {
      padding-top: 0 !important;
      padding-bottom: 8px !important;
    }
    section {
      margin-top: 14px !important;
    }
    .cv-role,
    .cv-block {
      break-inside: avoid;
      page-break-inside: avoid;
    }
    h1 {
      font-size: 22pt !important;
    }
    h2 {
      break-after: avoid;
      page-break-after: avoid;
    }
  }
</style>
