---
const path = Astro.url.pathname;
const links = [
  { href: '/work', label: 'Work' },
  { href: '/blog', label: 'Writing' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
---
<header class="flex items-center justify-between px-6 sm:px-10 py-6 text-sm">
  <a href="/" class="font-medium tracking-tight">Aaron Dsilva</a>
  <nav class="flex items-center gap-6">
    {links.map(l => (
      <a href={l.href} class:list={["text-muted hover:text-fg transition-colors", path.startsWith(l.href) && "text-fg"]}>{l.label}</a>
    ))}
    <button data-theme-toggle aria-label="Toggle theme" class="text-soft hover:text-fg transition-colors cursor-pointer">◐</button>
  </nav>
</header>
